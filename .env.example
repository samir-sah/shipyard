# Local development only. Compose overrides service URLs with container hostnames.
DATABASE_URL=postgres://shipyard:shipyard-local@127.0.0.1:5432/shipyard
POSTGRES_PASSWORD=shipyard-local
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=shipyard-artifacts
S3_ACCESS_KEY_ID=shipyard-local
S3_SECRET_ACCESS_KEY=shipyard-local-secret
HOST=127.0.0.1
PORT=3000
BUILD_IMAGE=shipyard-builder:local
BUILD_TIMEOUT_MS=300000
BUILD_CPUS=1
BUILD_MEMORY_MB=512
BUILD_PIDS=128
WORKER_CONCURRENCY=1
MAX_ARTIFACT_BYTES=67108864
MAX_ARTIFACT_FILES=5000
MAX_LOG_BYTES=1048576
